  "movimiento": {
    "ease": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.22, 1, .36, 1)",
      "$description": "La de casi todo, y las DOS mitades de una navegación. Rápida al inicio, asentada al final."
    },
    "ease-in": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.4, .05, .75, .7)",
      "$description": "Solo para lo que se va por su cuenta: una hoja que se cierra. Arranca de inmediato y acelera."
    },
    "ease-suave": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.65, 0, .35, 1)",
      "$description": "Para lo que cambia sin entrar ni salir: el fundido entre fotogramas."
    },
    "ease-rebote": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.34, 1.56, .64, 1)",
      "$description": "RACIONADA. Con sobrepaso, y solo para lo que celebra: la medalla, la noche cumplida, el saldo que sube."
    },
    "t-1": {
      "$type": "duration",
      "$value": "140ms",
      "$description": "Respuesta al dedo. Por debajo de esto no se percibe."
    },
    "t-2": {
      "$type": "duration",
      "$value": "220ms",
      "$description": "Lo que se va."
    },
    "t-3": {
      "$type": "duration",
      "$value": "300ms",
      "$description": "Un cambio de estado."
    },
    "t-4": {
      "$type": "duration",
      "$value": "380ms",
      "$description": "Una hoja entera."
    },
    "t-nav": {
      "$type": "duration",
      "$value": "320ms",
      "$description": "Una navegación. El MISMO valor para la pantalla que entra y la que sale: si difieren, la lámina se parte en dos."
    }
  },
